# Environment variables for web_frontend
# Copy this file to .env and adjust values as needed. Do not commit your .env.

# Base URL for REST API (backend_api). Example: http://localhost:4000
REACT_APP_API_BASE_URL=http://localhost:4000

# Base URL for WebSocket endpoints. If not set, derived from API base:
# http -> ws, https -> wss. Example: ws://localhost:4000
REACT_APP_WS_BASE_URL=

# Enable in-frontend mock responses. Set to "false" to call the real backend.
# apiClient reads this and bypasses network when "true".
REACT_APP_ENABLE_MOCKS=true

# Build environment identifier (development|staging|production)
REACT_APP_BUILD_ENV=development

# Optional: Sentry DSN for error reporting (leave blank to disable)
REACT_APP_SENTRY_DSN=
