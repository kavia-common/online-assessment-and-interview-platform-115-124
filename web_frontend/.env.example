# Frontend environment variables for Online Assessment Platform (React)
# Copy this file to .env and adjust as needed for your environment.

# Base URL for REST API (FastAPI backend)
REACT_APP_API_BASE_URL=http://localhost:8000

# Base URL for WebSocket connections (FastAPI backend)
REACT_APP_WS_BASE_URL=ws://localhost:8000

# Enable mocks for development without backend (false for preview/deployment)
REACT_APP_ENABLE_MOCKS=false
