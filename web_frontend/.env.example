# React Frontend - Example Environment Variables

# Backend REST API base
# Example: http://localhost:8000 for dev
REACT_APP_API_BASE_URL=http://localhost:8000

# Backend WebSocket base
# Example: ws://localhost:8000 for dev (use wss:// in production)
REACT_APP_WS_BASE_URL=ws://localhost:8000

# Feature flags / behavior
# Set "false" to call real backend, "true" to use in-frontend mocks (if available)
REACT_APP_ENABLE_MOCKS=false

# Optional: environment name for logs/observability
REACT_APP_BUILD_ENV=development

# Optional: Sentry DSN (do not commit real DSNs)
REACT_APP_SENTRY_DSN=
