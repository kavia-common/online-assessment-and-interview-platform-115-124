# Application
APP_ENV=development
APP_SECRET_KEY=change_me
APP_CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Database (PostgreSQL URL format)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/assessmentdb

# File storage
FILE_STORAGE_BACKEND=local  # local | s3
FILE_STORAGE_LOCAL_DIR=./storage

# S3 (if using s3 backend)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email backend
EMAIL_BACKEND=smtp   # smtp | sendgrid | console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# Reports
REPORT_EXPORT_DIR=./exports
