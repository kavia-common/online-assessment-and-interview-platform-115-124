# Core
APP_ENV=development
APP_SECRET_KEY=dev_secret_change_me
APP_CORS_ORIGINS=http://localhost:3000

# URLs (for docs/emails; align with frontend .env)
BACKEND_BASE_URL=http://localhost:8000
WEBSOCKET_BASE_URL=ws://localhost:8000
SITE_URL=http://localhost:3000

# Database (dev default uses SQLite file)
DATABASE_URL=sqlite:///./dev.db

# JWT/Access tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Storage
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=./storage

# S3 (if using s3 storage)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# Exports
REPORT_EXPORT_DIR=./exports
