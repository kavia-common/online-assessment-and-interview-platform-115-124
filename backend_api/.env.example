# FastAPI Backend - Example Environment Variables

# Core App
APP_NAME=Online Assessment Platform API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
# Comma separated list of allowed origins e.g., http://localhost:3000,https://your-frontend.example.com
APP_CORS_ORIGINS=http://localhost:3000

# URLs (used in emails, links, and for internal derivation)
SITE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
WEBSOCKET_BASE_URL=ws://localhost:8000

# Security / JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Example for Postgres: postgresql+psycopg2://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/assessment

# Storage (file uploads)
# STORAGE_BACKEND can be "local" or "s3"
STORAGE_BACKEND=local

# Local storage settings (used when STORAGE_BACKEND=local)
LOCAL_STORAGE_DIR=./data/uploads

# S3 storage settings (used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Email (notifications and triggers)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_TLS=true
EMAIL_SSL=false

# Exports (reports generation)
EXPORTS_DIR=./data/exports

# Logging
LOG_LEVEL=INFO
