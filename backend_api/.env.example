# FastAPI Backend - Environment Example
# Copy this file to .env and fill in appropriate values for your environment.
# Do not commit your real secrets.

# Core
APP_NAME=Online Assessment and Interview Platform API
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# CORS - comma separated origins
APP_CORS_ORIGINS=http://localhost:3000
# For legacy config module mapping:
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=./storage

# Database
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/oaip
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/oaip

# JWT / Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
# STORAGE_BACKEND options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=oaip@example.com

# Service URLs
SITE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
